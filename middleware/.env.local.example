# Copy to `.env.local` (gitignored). Used when running `npm run start:dev` on the host
# while Postgres/Kong/MinIO still run in Docker with published ports.

# Kong gateway — browser & host apps must use localhost, not http://kong:8000
SUPABASE_URL=http://localhost:8000

# From repo root `.env`: ANON_KEY and SERVICE_ROLE_KEY (middleware expects these names)
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# MinIO — from Windows/Mac host (published port 9000); keys must match MINIO_ROOT_* in root `.env`
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=cms-media

# Vertex AI — CRM/ITSM/PM/RAG and default AI Studio when STUDIO_AI_PROVIDER=vertex
# GOOGLE_CLOUD_PROJECT=my-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# Service account JSON path (relative to middleware/) or use `gcloud auth application-default login`
# GOOGLE_APPLICATION_CREDENTIALS=../volumes/google-credentials.json

# Google AI Studio (API key) — Studio indexing + chat without GCP (768-dim embeddings)
# Run once: psql ... -f middleware/sql/studio_embedding_google_ai_768.sql
# Then if match_studio_chunks fails: psql ... -f middleware/sql/fix_match_studio_chunks_filename.sql
# GOOGLE_API_KEY=
# GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
# GOOGLE_GENERATIVE_MODEL=gemini-2.5-flash
# EMBEDDING_PROVIDER=google_ai

# AI Studio only: Claude (Anthropic) instead of Vertex for chat / reports / guide-flow QU
# STUDIO_AI_PROVIDER=vertex   # default
# STUDIO_AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# ANTHROPIC_MAX_TOKENS=4096

# AI Studio WhatsApp hardening
# STUDIO_WHATSAPP_REQUIRE_ALLOWLIST=false   # default: true when NODE_ENV=production
# STUDIO_WHATSAPP_RATE_LIMIT_PER_MINUTE=10  # max inbound messages per phone per minute
