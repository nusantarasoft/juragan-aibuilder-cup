# Copy to `.env.local` (gitignored). Used when running `npm run start:dev` on the host
# while Postgres/Kong/MinIO still run in Docker with published ports.

# Kong gateway — browser & host apps must use localhost, not http://kong:8000
SUPABASE_URL=http://localhost:8000

# From repo root `.env`: ANON_KEY and SERVICE_ROLE_KEY (middleware expects these names)
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# MinIO — from Windows/Mac host (published port 9000); keys must match MINIO_ROOT_* in root `.env`
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=cms-media

# GCP service account for Vertex AI (optional — path relative to middleware/)
# Configure models, API keys, and providers in Admin → AI Studio → Settings (studio_settings DB).
# GOOGLE_APPLICATION_CREDENTIALS=../volumes/google-credentials.json

# F2-1 onboarding (production: Turnstile or hCaptcha required; never CAPTCHA_DISABLED)
# ONBOARDING_ALLOW_DEV_CAPTCHA=true   # local/QA only — enables dev HMAC captcha mint query
# ONBOARDING_CAPTCHA_SECRET=          # required when ONBOARDING_ALLOW_DEV_CAPTCHA=true (not f2-1-dev-captcha in prod)
# TURNSTILE_SECRET_KEY=
# TURNSTILE_SITE_KEY=                 # or NEXT_PUBLIC_TURNSTILE_SITE_KEY for admin register widget
# HCAPTCHA_SECRET=
# ONBOARDING_RATE_LIMIT_MAX=5
# ONBOARDING_RATE_LIMIT_EMAIL_MAX=3
# ONBOARDING_WA_PROVISION_MAX_PER_PHONE_DAY=2

# F2-3 tenant WA connect (OTP mock in QA only — WA_OTP_MOCK forbidden in production)
# WA_OTP_MOCK=true          # QA/local: skip Hermes, return mockCode in GraphQL
# WA_OTP_SECRET=            # required in production; dev may omit when WA_OTP_MOCK=true
# TRUST_PROXY=1
# TRUST_PROXY_HOPS=1

# AI Studio WhatsApp hardening
# STUDIO_WHATSAPP_REQUIRE_ALLOWLIST=false   # default: true when NODE_ENV=production
# STUDIO_WHATSAPP_RATE_LIMIT_PER_MINUTE=10  # max inbound messages per phone per minute
# STUDIO_UMKM_DAILY_REPORT_ENABLED=true

# Konten Marketing UMKM (galeri publik — bukan Instagram)
# STUDIO_MARKETING_CRON_ENABLED=false
# STUDIO_MARKETING_AI_PRODUCT_IMAGE=true
# STUDIO_MARKETING_AI_BACKGROUND=false
# STUDIO_MARKETING_PUBLIC_BASE_URL=https://your-middleware-host
# STUDIO_MARKETING_PUBLIC_RATE_MAX=120
# STUDIO_MARKETING_PUBLIC_RATE_WINDOW_MS=60000
