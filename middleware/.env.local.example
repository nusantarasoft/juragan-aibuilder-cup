# Copy to `.env.local` (gitignored). Used when running `npm run start:dev` on the host
# while Postgres/Kong/MinIO still run in Docker with published ports.

# Kong gateway — browser & host apps must use localhost, not http://kong:8000
SUPABASE_URL=http://localhost:8000

# From repo root `.env`: ANON_KEY and SERVICE_ROLE_KEY (middleware expects these names)
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# MinIO — from Windows/Mac host (published port 9000); keys must match MINIO_ROOT_* in root `.env`
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=cms-media

# GCP service account for Vertex AI (optional — path relative to middleware/)
# Configure models, API keys, and providers in Admin → AI Studio → Settings (studio_settings DB).
# GOOGLE_APPLICATION_CREDENTIALS=../volumes/google-credentials.json

# AI Studio WhatsApp hardening
# STUDIO_WHATSAPP_REQUIRE_ALLOWLIST=false   # default: true when NODE_ENV=production
# STUDIO_WHATSAPP_RATE_LIMIT_PER_MINUTE=10  # max inbound messages per phone per minute
