{
  "name": "middleware",
  "version": "1.0.0",
  "description": "NestJS GraphQL Middleware for Nusantarasoft CMS",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:studio": "vitest run src/studio",
    "test:studio:integration": "vitest run src/studio/studio.graphql.integration.spec.ts",
    "test:rag-eval": "vitest run src/studio/studio-rag-eval.integration.spec.ts",
    "test:studio:all-integration": "vitest run src/studio/studio.graphql.integration.spec.ts src/studio/studio-rag-eval.integration.spec.ts"
  },
  "dependencies": {
    "@google-cloud/vertexai": "^1.9.0",
    "@nestjs/apollo": "^12.2.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^10.4.1",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.1",
    "@nestjs/graphql": "^12.2.0",
    "@nestjs/platform-express": "^10.4.1",
    "@nestjs/platform-socket.io": "^10.4.1",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/websockets": "^10.4.1",
    "@supabase/supabase-js": "^2.45.0",
    "@types/graphql-type-json": "^0.3.5",
    "apollo-server-express": "^3.13.0",
    "axios": "^1.18.1",
    "fluent-ffmpeg": "^2.1.2",
    "google-auth-library": "^10.5.0",
    "graphql": "^16.9.0",
    "graphql-scalars": "^1.25.0",
    "graphql-type-json": "^0.3.2",
    "graphql-upload-ts": "^2.1.3",
    "jszip": "^3.10.1",
    "minio": "^8.0.0",
    "nodemailer": "^6.9.0",
    "pdf-parse": "^2.4.5",
    "pdf2pic": "^3.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.33.2",
    "socket.io": "^4.8.3",
    "xstate": "^5.31.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.2",
    "@nestjs/schematics": "^10.1.3",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/sharp": "^0.31.1",
    "typescript": "^5.5.4",
    "vitest": "^4.1.5"
  }
}
