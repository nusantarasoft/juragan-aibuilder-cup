; DNS Zone file for nusantarasoft.com
; Production mail server configuration
; Replace YOUR_VPS_IP with your actual VPS public IP address

$TTL    86400
@       IN      SOA     ns1.nusantarasoft.com. admin.nusantarasoft.com. (
                        2024121901      ; Serial (YYYYMMDDNN)
                        3600            ; Refresh (1 hour)
                        1800            ; Retry (30 minutes)
                        604800          ; Expire (1 week)
                        86400 )         ; Minimum TTL (1 day)

; Name Servers
@       IN      NS      ns1.nusantarasoft.com.
@       IN      NS      ns2.nusantarasoft.com.

; A Records - Replace YOUR_VPS_IP with your actual IP
@       IN      A       YOUR_VPS_IP
ns1     IN      A       YOUR_VPS_IP
ns2     IN      A       YOUR_VPS_IP
mail    IN      A       YOUR_VPS_IP
www     IN      A       YOUR_VPS_IP

; MX Record - Mail Exchange
@       IN      MX      10 mail.nusantarasoft.com.

; SPF Record - Sender Policy Framework
; Authorizes your VPS IP to send mail for this domain
@       IN      TXT     "v=spf1 mx ip4:YOUR_VPS_IP -all"

; DKIM Record - DomainKeys Identified Mail
; The public key will be generated by docker-mailserver on first run
; After running setup, check: docker exec mailserver cat /tmp/docker-mailserver/opendkim/keys/nusantarasoft.com/mail.txt
; Then add the record below (example format):
mail._domainkey IN      TXT     "v=DKIM1; k=rsa; p=YOUR_DKIM_PUBLIC_KEY_HERE"

; DMARC Record - Domain-based Message Authentication
_dmarc  IN      TXT     "v=DMARC1; p=quarantine; rua=mailto:admin@nusantarasoft.com; ruf=mailto:admin@nusantarasoft.com; fo=1"

; CAA Record - Certificate Authority Authorization (optional, for SSL)
@       IN      CAA     0 issue "letsencrypt.org"

; Additional subdomains
api     IN      A       YOUR_VPS_IP
portal  IN      A       YOUR_VPS_IP
