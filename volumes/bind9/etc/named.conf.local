// Local zone configuration
zone "nusantarasoft.dev" {
    type master;
    file "/data/bind/zones/db.nusantarasoft.dev";
    allow-query { any; };
    allow-transfer { none; };
};
zone "nusantarasoft.local" {
    type master;
    file "/data/bind/zones/db.nusantarasoft.local";
    allow-query { any; };
    allow-transfer { none; };
};
zone "nusantarasoft.com" {
    type master;
    file "/data/bind/zones/db.nusantarasoft.com";
    allow-query { any; };
    allow-transfer { none; };
};
