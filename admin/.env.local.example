# Copy to `.env.local` (gitignored). Used when running `npm run dev` on the host.

# Supabase API via Kong (default compose publishes ${KONG_HTTP_PORT:-8000})
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000

# GraphQL — browser + Next.js server must reach middleware on the host (not `middleware` hostname)
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4001/graphql
GRAPHQL_API_URL=http://127.0.0.1:4001/graphql

# MinIO public endpoint for the browser
NEXT_PUBLIC_S3_ENDPOINT=http://127.0.0.1:9000

# Copy these from repo root `.env` (same bucket/credentials as Docker middleware)
NEXT_PUBLIC_S3_BUCKET=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Cloudflare Workers AI (FLUX) — used by MIDDLEWARE Konten Marketing, not admin UI.
# Set the same keys in repo root `.env` / `.env.master-production` for docker middleware.
# CL_ACCOUNT_ID=
# CL_API_KEY=
