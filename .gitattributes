# Auto-detect text files and normalize line endings
* text=auto

# Force LF for scripts and config files used in Linux containers
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.exs text eol=lf
*.conf text eol=lf
*.env text eol=lf

# Dockerfile must use LF
Dockerfile text eol=lf
Dockerfile.* text eol=lf

# Keep binary files as-is
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
