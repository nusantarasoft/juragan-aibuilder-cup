# ═══════════════════════════════════════════════════════════════════════════
# .env.master-production.example  —  template for the GO-LIVE deploy
#
# Copy to `.env.master-production` (git-ignored) and fill REAL secrets.
# Used with: docker compose -f docker-compose.master-production.yml \
#              --env-file .env.master-production up -d --build
#
# NOTE: This is a full superset based on the dev `.env`. Only the values below
# marked (PROD) differ from dev — everything else can be copied from `.env`.
# ═══════════════════════════════════════════════════════════════════════════

# ── Secrets — GENERATE STRONG VALUES (PROD) ──────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_random
POSTGRES_DB=nusantarasoft
JWT_SECRET=CHANGE_ME_min_40_chars_random
# ANON_KEY / SERVICE_ROLE_KEY must be JWTs signed with the JWT_SECRET above
# (role=anon / role=service_role, iss=supabase). Regenerate when JWT_SECRET changes.
ANON_KEY=CHANGE_ME_signed_jwt_anon
SERVICE_ROLE_KEY=CHANGE_ME_signed_jwt_service_role
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=CHANGE_ME
SECRET_KEY_BASE=CHANGE_ME_64_chars
VAULT_ENC_KEY=CHANGE_ME_32_chars
PG_META_CRYPTO_KEY=CHANGE_ME_32_chars

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── MinIO / S3 ───────────────────────────────────────────────────────────────
MINIO_ROOT_USER=supa-storage
MINIO_ROOT_PASSWORD=CHANGE_ME
S3_BUCKET=cms-media

# ── Supavisor pooler ─────────────────────────────────────────────────────────
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=your-tenant-id
POOLER_DB_POOL_SIZE=5

# ── Kong ports (internal only in this deploy) ────────────────────────────────
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# ── PostgREST ────────────────────────────────────────────────────────────────
PGRST_DB_SCHEMAS=public,storage,graphql_public

# ── Auth / URLs (PROD — point to the public host 31.97.66.39:8090 via nginx) ─
SITE_URL=http://31.97.66.39:8090
API_EXTERNAL_URL=http://31.97.66.39:8090/supabase
SUPABASE_PUBLIC_URL=http://31.97.66.39:8090/supabase
ADDITIONAL_REDIRECT_URLS=http://31.97.66.39:8090,http://31.97.66.39:3013
# Browser origins allowed to call the middleware GraphQL API (CORS)
CORS_ORIGINS=http://31.97.66.39:3013,http://31.97.66.39:8090
JWT_EXPIRY=3600
DISABLE_SIGNUP=true
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
SMTP_SENDER_NAME=Nusantarasoft
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

# ── Studio ───────────────────────────────────────────────────────────────────
STUDIO_DEFAULT_ORGANIZATION=Nusantarasoft
STUDIO_DEFAULT_PROJECT=Nusantarasoft
IMGPROXY_ENABLE_WEBP_DETECTION=true
OPENAI_API_KEY=

# ── Functions ────────────────────────────────────────────────────────────────
FUNCTIONS_VERIFY_JWT=false

# ── Analytics / logs ─────────────────────────────────────────────────────────
LOGFLARE_PUBLIC_ACCESS_TOKEN=CHANGE_ME
LOGFLARE_PRIVATE_ACCESS_TOKEN=CHANGE_ME
DOCKER_SOCKET_LOCATION=/var/run/docker.sock

# ── WhatsApp webhook HMAC (shared by Hermes kasir-pipe + middleware) ─────────
# Prefer WHATSAPP_WEBHOOK_HMAC_KEY; WAHA_WEBHOOK_HMAC_KEY still accepted during transition
WHATSAPP_WEBHOOK_HMAC_KEY=CHANGE_ME
WHATSAPP_HOOK_URL=http://middleware:4001/api/studio/whatsapp/webhook

# ── Hermes (sole WhatsApp transport on production) ───────────────────────────
# Pin a release tag — never bare :latest on prod. Tags: https://hub.docker.com/r/nousresearch/hermes-agent/tags
HERMES_IMAGE=nousresearch/hermes-agent:v2026.8.27
HERMES_BASE_URL=http://hermes:8642
HERMES_BRIDGE_URL=http://hermes:8765
HERMES_GATEWAY_PORT=8652
HERMES_DASHBOARD_PORT=9129
HERMES_DASHBOARD=1
# Dashboard GUI login (required when dashboard binds non-loopback inside container)
# Real values: scripts/master-production/deploy.local.env (gitignored) + server .env.master-production
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=CHANGE_ME
HERMES_DASHBOARD_BASIC_AUTH_SECRET=CHANGE_ME_openssl_rand_base64_32
WHATSAPP_PROVIDER=hermes
WHATSAPP_ENABLED=true
WHATSAPP_MODE=bot
# Bridge must accept inbound so kasir-pipe can forward; middleware allowlist still applies
WHATSAPP_ALLOWED_USERS=*
KASIR_WHATSAPP_WEBHOOK_URL=http://middleware:4001/api/studio/whatsapp/webhook
KASIR_PIPE_SESSION=hermes
KASIR_BRIDGE_PROXY=1
KASIR_BRIDGE_PROXY_PORT=8765
# Pipe-only Phase 1: no LLM provider keys required on the server for kasir transport
# HMAC fail-closed when WHATSAPP_WEBHOOK_HMAC_KEY (or legacy WAHA_*) set; local escape: WAHA_WEBHOOK_HMAC_ALLOW_MISSING=true

# ── LabelStudio (optional) ───────────────────────────────────────────────────
LABELSTUDIO_API_TOKEN=
LABELSTUDIO_PROJECT_ID=
LABELSTUDIO_WEBHOOK_SECRET=
