# ── Hermes Agent (sole WhatsApp transport in docker-compose.yml) ────────────
# See docs/aistudio/umkm-wa/system/hermes-local.md and hermes-gaps.md (pin image — avoid bare :latest)
HERMES_IMAGE=nousresearch/hermes-agent:v2026.8.27
# Offset from Hermes Desktop defaults (8642/9119)
HERMES_GATEWAY_PORT=8652
HERMES_DASHBOARD_PORT=9129
HERMES_DASHBOARD=1
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=CHANGE_ME
HERMES_DASHBOARD_BASIC_AUTH_SECRET=CHANGE_ME
WHATSAPP_PROVIDER=hermes
HERMES_BASE_URL=http://hermes:8642
HERMES_BRIDGE_URL=http://hermes:8765
WHATSAPP_WEBHOOK_HMAC_KEY=CHANGE_ME

# Optional provider keys (or run: docker compose run --rm -it hermes setup)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
