# ═════════════════════════════════════════════════════════════════════════════
# Google Cloud Run — Environment Variables Template (.env.cloudrun.example)
# Copy to .env.cloudrun (gitignored) or configure in Cloud Build trigger /
# Secret Manager. Do not commit real secrets.
# ═════════════════════════════════════════════════════════════════════════════

# GCP Project & Region
GCP_PROJECT_ID=juragan-aibuilder-cup
GCP_REGION=asia-southeast2
# Artifact Registry repo may keep the legacy name `nusantarasoft`
AR_REPO=nusantarasoft

# Cloud Run Service Names (must match live services — migration-safe updates)
API_SERVICE=juragan-api
ADMIN_SERVICE=juragan
LANDING_SERVICE=juragan-landing
SHOWCASE_SERVICE=juragan-showcase

# ── VPS nusantarasoft deps (do not re-provision on GCP for v1) ───────────────
# Point Cloud Run at existing Supabase/Kong, S3, Hermes on the VPS.
SUPABASE_URL=https://your-supabase-or-vps-kong.example
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-or-vps-kong.example
S3_ENDPOINT=https://your-vps-s3-or-gcs.example
S3_BUCKET=cms-media
S3_REGION=asia-southeast2
HERMES_BASE_URL=https://hermes.your-vps.example
HERMES_BRIDGE_URL=https://hermes-bridge.your-vps.example
WHATSAPP_PROVIDER=hermes

# Optional landing runtime
NEXT_PUBLIC_CMS_API_URL=
NEXT_PUBLIC_KASIR_WA_URL=

# ── Prefer Secret Manager (names are suggestions; create in GCP) ─────────────
# gcloud secrets create supabase-anon-key --data-file=-
# gcloud secrets create supabase-service-key --data-file=-
# gcloud secrets create s3-access-key --data-file=-
# gcloud secrets create s3-secret-key --data-file=-
# gcloud secrets create whatsapp-webhook-hmac --data-file=-
#
# Then on Cloud Run / in cloudbuild deploy steps use e.g.:
#   --set-secrets=SUPABASE_ANON_KEY=supabase-anon-key:latest,\
#     SUPABASE_SERVICE_KEY=supabase-service-key:latest,\
#     S3_ACCESS_KEY=s3-access-key:latest,S3_SECRET_KEY=s3-secret-key:latest
#
# Placeholders below are for local docs only — do not paste real values into
# Cloud Build substitution variables (they appear in build history).
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
# SUPABASE_SERVICE_KEY → Secret Manager: supabase-service-key
# S3_ACCESS_KEY → Secret Manager: s3-access-key
# S3_SECRET_KEY → Secret Manager: s3-secret-key
# WHATSAPP_WEBHOOK_HMAC_KEY → Secret Manager: whatsapp-webhook-hmac
