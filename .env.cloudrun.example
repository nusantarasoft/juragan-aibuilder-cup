# ═════════════════════════════════════════════════════════════════════════════
# Google Cloud Run — Environment Variables Template (.env.cloudrun.example)
# Copy to .env.cloudrun (gitignored) or configure in Cloud Build trigger / Secret Manager
# ═════════════════════════════════════════════════════════════════════════════

# GCP Project & Region
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-southeast2
AR_REPO=nusantarasoft

# Cloud Run Service Names
MIDDLEWARE_SERVICE=nusantarasoft-middleware
ADMIN_SERVICE=nusantarasoft-admin

# Supabase Configuration (Supabase Cloud or self-hosted Supabase public URL)
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Storage / S3 Compatible Endpoint (GCS S3 Interop, Supabase Storage, or MinIO)
S3_ENDPOINT=https://storage.googleapis.com
S3_BUCKET=cms-media
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_REGION=asia-southeast2

# Optional: WhatsApp / Hermes Bridge URL (if Hermes runs on a VM/GCE instance)
WHATSAPP_PROVIDER=hermes
HERMES_BASE_URL=https://hermes.yourdomain.com
HERMES_BRIDGE_URL=https://hermes-bridge.yourdomain.com
WHATSAPP_WEBHOOK_HMAC_KEY=your-webhook-hmac-secret
