# ═════════════════════════════════════════════════════════════════════════════
# Google Cloud Run — Environment Variables Template (.env.cloudrun.example)
# Copy to .env.cloudrun (gitignored). Use for local notes / export of *non-secret*
# URLs before `./scripts/deploy-cloudrun.sh`. Do not commit real secrets.
#
# Sensitive values live in GCP Secret Manager (exact ids below) and are wired
# by cloudbuild.yaml via --set-secrets / availableSecrets — not substitutions.
# ═════════════════════════════════════════════════════════════════════════════

# GCP Project & Region
GCP_PROJECT_ID=juragan-aibuilder-cup
GCP_REGION=asia-southeast2
# Artifact Registry repo may keep the legacy name `nusantarasoft`
AR_REPO=nusantarasoft

# Cloud Run Service Names (must match live services — migration-safe updates)
# Out of scope: juragan-landing / landing-page/ (not deployed to Cloud Run)
API_SERVICE=juragan-api
ADMIN_SERVICE=juragan
SHOWCASE_SERVICE=juragan-showcase

# ── VPS nusantarasoft deps (do not re-provision on GCP for v1) ───────────────
# Safe as Cloud Build substitutions / --set-env-vars:
SUPABASE_URL=https://your-supabase-or-vps-kong.example
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-or-vps-kong.example
S3_ENDPOINT=https://your-vps-s3-or-gcs.example
S3_BUCKET=cms-media
S3_REGION=asia-southeast2
HERMES_BASE_URL=https://hermes.your-vps.example
HERMES_BRIDGE_URL=https://hermes-bridge.your-vps.example
WHATSAPP_PROVIDER=hermes

# Optional external marketing URL for showcase bake only (no Cloud Run landing)
# NEXT_PUBLIC_LANDING_URL=

# ── Secret Manager ids (exact — must match cloudbuild.yaml) ─────────────────
# Create once (values from VPS — Akbar fills; do not invent):
#
#   PROJECT=juragan-aibuilder-cup
#   printf '%s' "$SUPABASE_ANON_KEY"    | gcloud secrets create supabase-anon-key    --project=$PROJECT --replication-policy=automatic --data-file=-
#   printf '%s' "$SUPABASE_SERVICE_KEY" | gcloud secrets create supabase-service-key --project=$PROJECT --replication-policy=automatic --data-file=-
#   printf '%s' "$S3_ACCESS_KEY"        | gcloud secrets create s3-access-key        --project=$PROJECT --replication-policy=automatic --data-file=-
#   printf '%s' "$S3_SECRET_KEY"        | gcloud secrets create s3-secret-key        --project=$PROJECT --replication-policy=automatic --data-file=-
#   # optional:
#   printf '%s' "$WHATSAPP_WEBHOOK_HMAC_KEY" | gcloud secrets create whatsapp-webhook-hmac-key --project=$PROJECT --replication-policy=automatic --data-file=-
#
# Then grant Cloud Build + Cloud Run SAs roles/secretmanager.secretAccessor
# (see docs/deploy-cloud-run.md).
#
# Mapping (env ← secret id):
#   SUPABASE_ANON_KEY / NEXT_PUBLIC_SUPABASE_ANON_KEY ← supabase-anon-key
#   SUPABASE_SERVICE_KEY                              ← supabase-service-key
#   S3_ACCESS_KEY                                     ← s3-access-key
#   S3_SECRET_KEY                                     ← s3-secret-key
#   WHATSAPP_WEBHOOK_HMAC_KEY                         ← whatsapp-webhook-hmac-key (optional; set _SECRET_WA_HMAC)
SECRET_SUPABASE_ANON=supabase-anon-key
SECRET_SUPABASE_SERVICE=supabase-service-key
SECRET_S3_ACCESS=s3-access-key
SECRET_S3_SECRET=s3-secret-key
# SECRET_WA_HMAC=whatsapp-webhook-hmac-key
