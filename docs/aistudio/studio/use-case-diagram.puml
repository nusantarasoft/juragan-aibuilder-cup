@startuml ai-studio-studio-use-case
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #f8fafc
  BorderColor #7c3aed
  FontSize 12
}
skinparam rectangle {
  BorderColor #94a3b8
  BackgroundColor #ffffff
}

title AI Studio — Menu Studio (NotebookLM Layout)\nUse Case Diagram (/admin/ai-studio)

actor "Pengguna Admin" as Admin
actor "Middleware\n(StudioIngestionService)" as MW <<system>>

rectangle "AI Studio — Studio (NotebookLM)" {
  package "Header & Notebook" {
    usecase "UC-01\nLihat Daftar Notebook" as UC01
    usecase "UC-02\nBuat Notebook" as UC02
    usecase "UC-03\nPilih Notebook\n(dropdown header)" as UC03
    usecase "UC-04\nHapus Notebook" as UC04
    usecase "UC-37\nUpdate Notebook\n(nama / instruksi chat)" as UC37
  }

  package "Panel Sources (Kiri)" {
    usecase "UC-05\nTambah Sumber\ndari Media Library" as UC05
    usecase "UC-06\nUpload File\nke Notebook" as UC06
    usecase "UC-07\nHapus Sumber" as UC07
    usecase "UC-08\nReindex Sumber" as UC08
    usecase "UC-09\nMonitor Status\nIndeksasi" as UC09
    usecase "UC-29\nFilter Sumber\nuntuk Chat (checkbox)" as UC29
    usecase "UC-30\nConfigure Chat\n(chat_instruction)" as UC30
    usecase "UC-33\nImport URL\nsebagai Sumber" as UC33
  }

  package "Proses Indeksasi (Sistem)" as PKG_IDX {
    usecase "UC-19\nEkstraksi Teks\n(extractDocumentText)" as UC19
    usecase "UC-20\nChunking Teks\n(chunkText)" as UC20
    usecase "UC-21\nVektorisasi\n(embedText)" as UC21
    usecase "UC-22\nSimpan Chunk +\nEmbedding ke DB" as UC22
  }

  package "Panel Chat (Tengah)" {
    usecase "UC-10\nChat RAG\n(Tanya Jawab Bebas)" as UC10
    usecase "UC-11\nChat Guided Flow" as UC11
    usecase "UC-12\nMulai Chat Baru" as UC12
    usecase "UC-13\nLihat Referensi\nSumber Jawaban" as UC13
    usecase "UC-26\nLanjutkan Riwayat\nPercakapan" as UC26
    usecase "UC-27\nPilih Mode Chat\n(Bebas / Guided)" as UC27
    usecase "UC-31\nAuto Notebook Brief\n(setelah indeksasi)" as UC31
    usecase "UC-32\nPreview Chunk\nKutipan (drawer)" as UC32
    usecase "UC-36\nLayout 3-Kolom\nSources|Chat|Studio" as UC36
  }

  package "Panel Studio (Kanan)" {
    usecase "UC-14\nGenerate\nExecutive Report" as UC14
    usecase "UC-34\nGenerate Artefak\n(mind map, quiz, FAQ, …)" as UC34
    usecase "UC-35\nKelola Library\nOutput (list/hapus)" as UC35
  }

  package "Advanced — Guide Flows\n(/advanced/guide-flows)" {
    usecase "UC-15\nKelola Guide Flow\n(buat / edit / hapus)" as UC15
    usecase "UC-16\nPublish Guide Flow" as UC16
    usecase "UC-17\nSimulasi Guide Flow" as UC17
    usecase "UC-23\nValidasi Graph\nFlow (Zod + XState)" as UC23
    usecase "UC-24\nBuat dari Template\n(RAG / UMKM / Kosong)" as UC24
    usecase "UC-25\nRuntime Node Pipeline\n(listen->rag->sql->action)" as UC25
  }

  package "Advanced — Playground\n(/advanced/playground)" {
    usecase "UC-18\nUji Prompt &\nKonfigurasi Model" as UC18
    usecase "UC-18b\nLihat Metrik\nLatency & Token" as UC18b
  }
}

